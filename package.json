    "preview": "vite preview",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "webmcp-types": "^0.1.5"
  },
  "license": "MIT"
}
