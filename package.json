{
  "name": "countrylab-webmcp",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic human-agent economic simulation for the OpenAI WebMCP Challenge.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
